# ============================================================================
# docker compose 的环境变量模板
#   用法：cp .env.example .env   然后按下表逐项改成你自己的值
#   注意：.env 已被 .gitignore 忽略，不会被提交；**不要**把真实口令写回本文件
# ============================================================================

# ---- 元数据库（MySQL 8.0）----
DATASYNC_DB_NAME=datasync
# MySQL root 口令。首次 `docker compose up` 时由 MySQL 镜像写入数据卷，
# 之后再改这里不会同步修改已有数据卷里的口令（需要进容器改或删卷重建）。
DATASYNC_DB_PASSWORD=change-me-strong-password

# ---- 应用对外端口 ----
DATASYNC_HTTP_PORT=8080

# ---- 登录账号 ----
DATASYNC_ADMIN_USER=admin
# 登录口令。留空会导致 prod profile 启动失败（这是刻意的 fail-fast）。
DATASYNC_ADMIN_PASSWORD=change-me-admin-password

# ---- 数据源口令加密密钥（AES-GCM）----
# 至少 32 字符。**一旦用于生产就不要随意更换**：换了以后库里已存的密文无法解密，
# 所有数据源口令都会失效，需要逐个重新录入。请纳入密钥管理与备份。
DATASYNC_SECRET_KEY=change-me-32-chars-minimum-secret-key-000000

# ---- 同步引擎调优（可选，有默认值）----
# 同时执行的同步任务数上限
DATASYNC_WORKER_THREADS=4
# 单条查询超时（秒）
DATASYNC_QUERY_TIMEOUT=300
# 停机时等待运行中任务收尾的秒数
DATASYNC_SHUTDOWN_TIMEOUT=60
